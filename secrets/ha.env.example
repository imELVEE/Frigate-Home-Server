# Home Assistant / Frigate / MQTT / nginx env (template)
# Copy to ~/secrets/ha.env and chmod 600

HA_EXTERNAL_HOST=home.example.net
EXTERNAL_URL=https://home.example.net
INTERNAL_URL=http://homeassistant:8123

LAN_SUBNET=192.168.50.0/24
HA_LAN_IP=192.168.50.10

MQTT_USER=ha_mqtt_user
MQTT_PASSWORD=change-me

MY_PHONE=notify.mobile_app_primary_phone
SOMEONE_ELSE_PHONE=notify.mobile_app_secondary_phone

FRIGATE_NVR_HOST=192.168.50.20

FRIGATE_BACKYARD_RTSP_USER=camuser
FRIGATE_BACKYARD_RTSP_PASSWORD=cam-pass
FRIGATE_SIDE_GATE_RTSP_USER=camuser
FRIGATE_SIDE_GATE_RTSP_PASSWORD=cam-pass
FRIGATE_DRIVEWAY_RTSP_USER=camuser
FRIGATE_DRIVEWAY_RTSP_PASSWORD=cam-pass
FRIGATE_FRONT_DOOR_RTSP_USER=camuser
FRIGATE_FRONT_DOOR_RTSP_PASSWORD=cam-pass
