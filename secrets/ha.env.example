# Home Assistant / Frigate / MQTT / nginx env (template)
# Copy to ~/secrets/ha.env and chmod 600

HA_EXTERNAL_HOST=replace-with-public-hostname
EXTERNAL_URL=https://replace-with-public-hostname
INTERNAL_URL=http://homeassistant:8123

LAN_SUBNET=replace-with-lan-cidr
HA_LAN_IP=replace-with-server-lan-address

MQTT_USER=replace-with-mqtt-username
MQTT_PASSWORD=replace-with-mqtt-password

MY_PHONE=replace-with-primary-notify-service
SOMEONE_ELSE_PHONE=replace-with-secondary-notify-service

FRIGATE_NVR_HOST=replace-with-nvr-lan-address

FRIGATE_BACKYARD_RTSP_USER=replace-with-camera-username
FRIGATE_BACKYARD_RTSP_PASSWORD=replace-with-camera-password
FRIGATE_SIDE_GATE_RTSP_USER=replace-with-camera-username
FRIGATE_SIDE_GATE_RTSP_PASSWORD=replace-with-camera-password
FRIGATE_DRIVEWAY_RTSP_USER=replace-with-camera-username
FRIGATE_DRIVEWAY_RTSP_PASSWORD=replace-with-camera-password
FRIGATE_FRONT_DOOR_RTSP_USER=replace-with-camera-username
FRIGATE_FRONT_DOOR_RTSP_PASSWORD=replace-with-camera-password
