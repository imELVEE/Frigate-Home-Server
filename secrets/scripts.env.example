# Host-side scripts env (template)
# Copy to ~/secrets/scripts.env and chmod 600

HA_TOKEN=replace-with-long-lived-access-token

EMAIL_SMTP_SERVER=replace-with-smtp-host
EMAIL_SMTP_PORT=465
EMAIL_USER=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_FROM=replace-with-sender-address
EMAIL_TO=replace-with-recipient-address
