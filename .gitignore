# Secrets and envs
home/**/secrets/*
!home/**/secrets/*.example
.env
.env.*
*.env
*.key
*.pem
*.crt
*.p12
*.pfx
*.jks
*.csr

# SSH host keys
etc/ssh/ssh_host_*

# CrowdSec credentials
etc/crowdsec/*_credentials.yaml
etc/crowdsec/bouncers/*.yaml
etc/crowdsec/bouncers/

# Personal/system state (PII, host artifacts)
.ssh/
.bash_history
.bashrc
.profile
.lesshst
.wget-hsts
.cache/
.local/
.cloudflared/
.codex/
.docker/
.vscode/
.vscode-server/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
home/**/.bash_logout
home/**/.sudo_as_admin_successful
home/**/.dotnet/

# Editor/OS temp files
*.swp
*.swo
*.orig
*.tmp

# Python build/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/

# Home Assistant runtime/state
ha/homeassistant/home-assistant_v2.db*
ha/homeassistant/.storage/
ha/homeassistant/home-assistant.log*
ha/homeassistant/ip_bans.yaml
ha/homeassistant/secrets.yaml
ha/homeassistant/.ha_run.lock
ha/homeassistant/.HA_VERSION
ha/homeassistant/.cloud/
ha/homeassistant/tts/

# ACME keys/certs
ha/acme/

# Mosquitto state/keys
ha/mosquitto/data/
ha/mosquitto/config/passwd
ha/mosquitto/config/passwd.backup*
ha/mosquitto/config/mosquitto.conf
ha/mosquitto/ca_secure/
ha/mosquitto/config/tls/
ha/mosquitto/log/

# Nginx logs
ha/nginx/log/
ha/nginx/logs/
ha/nginx/ssl/
ha/homeassistant/tls/

# Frigate state/media backups
ha/frigate/config/backup.db
ha/frigate/media/
ha/frigate/config/.jwt_secret
ha/frigate/config/.exports
ha/frigate/config/.timeline
ha/frigate/config/.vacuum

# Nginx rendered configs (templates are tracked instead)
ha/nginx/conf.d/homeassistant.conf
ha/nginx/conf.d/00-healthz.conf

# Ignore host /etc snapshot; re-allow custom unit files we track
etc/**
!etc/systemd/
!etc/systemd/system/
!etc/systemd/system/acme-renew.service
!etc/systemd/system/acme-renew.timer
!etc/systemd/system/server-healthcheck.service
!etc/systemd/system/server-healthcheck.timer
!etc/systemd/system/docker-prune.service
!etc/systemd/system/docker-prune.timer
!etc/systemd/system/compose-rebuild-ha.service
!etc/systemd/system/compose-rebuild-ha.timer
!etc/systemd/system/weekly-reboot.service
!etc/systemd/system/weekly-reboot.timer
!etc/systemd/system/ha-stack.service

