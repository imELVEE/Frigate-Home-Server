server {
  listen 443 ssl default_server;
  server_name ${HA_EXTERNAL_HOST};
  include /etc/nginx/conf.d/ha-extra/*.conf;

  # Dynamic DNS for Docker service names
  resolver 127.0.0.11 valid=30s ipv6=off;

  # --- SSL certs (mounted at /etc/ssl) ---
  ssl_certificate     /etc/ssl/fullchain.pem;
  ssl_certificate_key /etc/ssl/privkey.pem;

  # --- Strong TLS ---
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers 'ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384';
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_session_tickets off;
  # OCSP stapling disabled (optional)
  # ssl_stapling on;
  # ssl_stapling_verify on;

  # --- Security headers ---
  server_tokens off;
  proxy_hide_header X-Powered-By;
  add_header X-Powered-By "";
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-XSS-Protection "1; mode=block" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

  # --- Per-IP concurrent connection cap (zone from 00-globals.conf) ---
  limit_conn addr 20;

  # --- Method & traversal sanity ---
  if ($request_method !~ ^(GET|POST|HEAD|OPTIONS|PUT|DELETE)$) { return 405; }
  location ~ (\.\.\/|\.\.\\\\) { return 403; }

  # --- Only our host header is allowed ---
  if ($host != "${HA_EXTERNAL_HOST}") { return 444; }

  # --- WebSocket to HA: WAF OFF; must be before regex locations ---
  location ^~ /api/websocket {
    modsecurity off;

    # (No limit_req here to avoid WS flakiness)
    proxy_pass http://homeassistant:8123;
    proxy_http_version 1.1;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Origin            $scheme://$host;
    proxy_buffering off;
    proxy_read_timeout    3600s;
    proxy_send_timeout    3600s;
    proxy_connect_timeout   60s;
  }

  # --- Auth & API (but NOT /api/websocket): WAF ON + rate limit ---
  location ~ ^/(auth|api)(?!/websocket)(?:/|$) {
    limit_req zone=perip burst=40 nodelay;

    modsecurity on;
    modsecurity_rules "SecRuleEngine On";

    proxy_pass http://homeassistant:8123;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_set_header Origin            $scheme://$host;
    proxy_buffering off;
    proxy_read_timeout    3600s;
    proxy_send_timeout    3600s;
    proxy_connect_timeout   60s;
  }

  # --- Everything else (UI/static): WAF ON ---
  location / {
    # Enable WAF for UI/static
    modsecurity on;
    modsecurity_rules "SecRuleEngine On";

    proxy_pass http://homeassistant:8123;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    proxy_set_header Origin            $scheme://$host;
    proxy_buffering off;
    proxy_read_timeout    3600s;
    proxy_send_timeout    3600s;
    proxy_connect_timeout   60s;
  }

  # --- Request/header size (avoid SPA reload glitches) ---
  client_max_body_size 1m;
  client_header_buffer_size 4k;
  large_client_header_buffers 4 16k;
}
